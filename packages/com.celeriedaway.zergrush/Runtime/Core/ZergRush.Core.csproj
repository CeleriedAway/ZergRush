<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>preview</LangVersion>
    <IsPackable>false</IsPackable>
    <ZergRushCodeGenProjectPath Condition="'$(ZergRushCodeGenProjectPath)' == '' and Exists('$(MSBuildThisFileDirectory)../ZergRush.CodeGen/src/ZergRush.CodeGen.Core/ZergRush.CodeGen.Core.csproj')">$(MSBuildThisFileDirectory)../ZergRush.CodeGen/src/ZergRush.CodeGen.Core/ZergRush.CodeGen.Core.csproj</ZergRushCodeGenProjectPath>
    <Description>Pure C# utilities shared by ZergRush client and backend code.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="ZergRush.CodeGen.Core" Version="0.1.0-preview.4" Condition="'$(ZergRushCodeGenProjectPath)' == ''" />
    <PackageReference Include="ZergRush.Reactive" Version="0.1.0-preview.4" Condition="'$(ZergRushCodeGenProjectPath)' == ''" />
    <ProjectReference Include="$(ZergRushCodeGenProjectPath)" Condition="'$(ZergRushCodeGenProjectPath)' != ''" />
  </ItemGroup>
</Project>
